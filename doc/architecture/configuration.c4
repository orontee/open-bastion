model {

  /*
   * The configuration files open-bastion owns or rewrites.
   *
   * Two of them are the module's own contract (`openbastion.conf`, read by
   * every component through the shared configuration subsystem, and
   * `nss_openbastion.conf` for the NSS library); the rest are either written
   * by `ob-bastion-setup` (the PAM stacks, the sshd drop-in) or refreshed by a
   * timer (the revocation list, the JWKS).
   *
   * The paths are the ones `ob-bastion-setup` defines; the backend carries the
   * same set minus the ones only the hop needs.
   */
  extend platform.bastion {

    configuration = configuration {
      title 'Configuration'

      configuration_subsystem = component {
        #C
        technology 'compilation unit'
        summary 'Load configuration from file'
        description '
           The configuration is read from the configuration file, command
           line arguments and PAM module arguments
        '
        this .uses openbastion_conf
      }

      openbastion_conf = file {
        technology 'configuration file'
        title 'openbastion.conf'
      }

      nss_openbastion_conf = file {
        technology 'configuration file'
        title 'nss_openbastion.conf'
        summary '/etc/open-bastion/nss_openbastion.conf'
        description '
          Which portal the NSS library asks for an account, whether answers must
          be signed, and the pin of the portal certificate. Its mtime is watched:
          a pin changed in place is reloaded and re-checked.
        '
      }

      service_accounts_conf = file {
        technology 'configuration file'
        title 'service-accounts.conf'
        summary '/etc/open-bastion/service-accounts.conf'
        description '
          The local accounts allowed to authenticate without a portal round trip,
          each with the fingerprint of its key.
        '
      }

      session_recorder_conf = file {
        technology 'configuration file'
        title 'session-recorder.conf'
        summary '/etc/open-bastion/session-recorder.conf'
        description '
          What the recorder captures (shell, transfer, sudo), where it hands the
          stream over, and the retention the prune unit applies.
        '
      }

      ssh_proxy_conf = file {
        technology 'configuration file'
        title 'ssh-proxy.conf'
        summary '/etc/open-bastion/ssh-proxy.conf'
        description '
          The target list `ob-ssh`, `ob-scp` and `ob-sftp` accept, and the
          ephemeral key they mint a certificate for.
        '
      }

      bastion_token = file {
        technology 'JSON'
        title 'OIDC token'
        summary '/var/lib/open-bastion/token'
        description '
          The OIDC credential the portal issued for this host: an access token
          and a refresh token, rotated by `ob-heartbeat`. The module and the cert
          daemon read it, and the HTTP client presents it.
          Readable by root only.
        '

        ob_client .uses bastion_token 'presents the OIDC token'
        ob-cert.ob-cert-daemon .uses bastion_token 'reads it, as root only'
      }

      bastion_id = file {
        technology 'text file'
        title 'bastion-id'
        summary '/var/lib/open-bastion/bastion-id'
        description '
          The identifier this host presents to the portal. Kept across upgrades:
          a backend pins the bastions it accepts.
        '
      }

      sso_jwks = file {
        technology 'JWKS (JSON)'
        title 'sso-jwks.json'
        summary '/var/lib/open-bastion/jwks/sso-jwks.json'
        description '
          The portal signing keys the host checks answers against. Deployed at
          build time by the builder, rotated by `ob-heartbeat` only when the
          answer carrying the new set is signed by a key already in it (#339).
        '
      }

      openbastion_pam_stack = generated-file {
        technology 'PAM configuration'
        title 'PAM stacks'
        summary '/etc/pam.d/{sshd,sudo,sudo-i,systemd-user}'
        description '
          Generated by `ob-bastion-setup`: the sshd stack that authenticates a
          session, and the sudo stacks that authorise an elevation. Both call
          `pam_openbastion`; the order and the `pam_access` position are what the
          deployment decides.
        '

        style {
          multiple true
        }
      }

      sshd_dropin = generated-file {
        technology 'sshd configuration'
        title 'sshd drop-in'
        summary '/etc/ssh/sshd_config.d/open-bastion.conf'
        description '
          `AuthorizedPrincipalsCommand` (the fingerprint deposit), the trusted
          user CA, `RevokedKeys`, and the `ForceCommand` that starts the
          recorder.
        '
      }

      nsswitch_conf = generated-file {
        technology 'NSS configuration'
        title 'nsswitch.conf'
        summary '/etc/nsswitch.conf'
        description '
          `passwd: ... openbastion` and the group line: what makes the host ask
          the portal for an account the local files do not have.
        '
      }

      open_bastion_ca_pub = file {
        technology 'OpenSSH public key'
        title 'open-bastion_ca.pub'
        summary '/etc/ssh/open-bastion_ca.pub'
        description '
          The ssh-ca public key a backend trusts. Fetched from `/ssh/ca` by
          `ob-bastion-setup`, never typed by hand.
        '
      }

      revoked_keys = file {
        technology 'SSH KRL'
        title 'revoked_keys'
        summary '/etc/ssh/revoked_keys'
        description '
          The KRL sshd consults for every certificate. Refreshed from
          `/ssh/revoked`; a failed download leaves the previous list in place.
        '
      }

      audit_rules = file {
        technology 'audit rules'
        title 'open-bastion.rules'
        summary '/etc/audit/rules.d/open-bastion.rules'
        description '
          What the kernel audit records: the privilege transitions, the
          configuration file writes, the socket hand-offs.
        '
      }

      logrotate_conf = file {
        technology 'logrotate configuration'
        title 'logrotate: open-bastion'
        summary '/etc/logrotate.d/open-bastion'
      }

      hardening_logind = file {
        technology 'systemd-logind configuration'
        title 'logind.conf.d: open-bastion'
        summary '/etc/systemd/logind.conf.d/open-bastion.conf'
      }

      hardening_limits = file {
        technology 'PAM limits'
        title 'limits.d: open-bastion'
        summary '/etc/security/limits.d/open-bastion.conf'
      }

      hardening_at_allow = file {
        technology 'at allowlist'
        title 'at.allow'
        summary '/etc/at.allow'
      }

      hardening_cron_allow = file {
        technology 'cron allowlist'
        title 'cron.allow'
        summary '/etc/cron.allow'
      }

      /* What writes them: the installer, not the module. */
      ob_bastion_setup = executable {
        #Bash
        technology 'shell script'
        title 'ob-bastion-setup'
        summary 'Deployment and re-configuration entry point'

        this .produces openbastion_pam_stack
        this .produces sshd_dropin
        this .produces session_recorder_conf
        this .produces ssh_proxy_conf
        this .produces nsswitch_conf
        this .produces open_bastion_ca_pub
        this .produces hardening_logind
        this .produces hardening_limits
        this .produces hardening_at_allow
        this .produces hardening_cron_allow
        this .produces audit_rules
      }
    }
  }

  extend platform.protected-zone.backend {

    configuration = configuration {
      title 'Configuration'

      configuration_subsystem = component {
        #C
        technology 'compilation unit'
        summary 'Load configuration from file'
        description '
          The configuration is read from the configuration file, command line
          arguments and PAM module arguments.
        '

        this .uses openbastion_conf
      }

      openbastion_conf = file {
        technology 'configuration file'
        title 'openbastion.conf'
        summary '/etc/open-bastion/openbastion.conf'
        description '
          The keys of this backend: `create_user_enabled`, `create_home` and
          `default_shell` decide the account the portal asks this host to
          create on a first connection.
        '
      }


      openbastion_pam_stack = generated-file {
        technology 'PAM configuration'
        title 'PAM stacks'
        summary '/etc/pam.d/{sshd,sudo,sudo-i}'
        description '
          The stacks `ob-bastion-setup` generates on a backend: `pam_access`
          decides which local accounts may elevate, `pam_openbastion`
          authorises the elevation against the portal.
        '

        style {
          multiple true
        }

        openbastion_pam_stack .uses backend_pam_openbastion_so
      }

      open_bastion_ca_pub = file {
        technology 'OpenSSH public key'
        title 'open-bastion_ca.pub'
        summary '/etc/ssh/open-bastion_ca.pub'
        description '
          The ssh-ca public key this backend trusts. Fetched from `/ssh/ca`
          by `ob-bastion-setup`, never typed by hand: a certificate is
          accepted only if it chains to it.
        '
      }

      revoked_keys = file {
        technology 'SSH KRL'
        title 'revoked_keys'
        summary '/etc/ssh/revoked_keys'
        description '
          The revocation list this backend checks every certificate against.
          Refreshed from `/ssh/revoked` by the same timer unit as on the
          bastion, and left unchanged when a download fails or does not parse
          as a KRL.
        '
      }

      token = file {
        technology 'JSON'
        title 'OIDC token'
        summary '/var/lib/open-bastion/token'
        description '
          The OIDC credential the portal issued to this backend when it was
          enrolled: the access token the HTTP client presents on
          `/pam/authorize`, and the refresh token `ob-heartbeat` rotates.
          Readable by root only.
        '

        backend_ob_client .uses token 'presents the OIDC token'
      }

      sso_jwks = file {
        technology 'JWKS (JSON)'
        title 'sso-jwks.json'
        summary '/var/lib/open-bastion/jwks/sso-jwks.json'
        description '
          The portal signing keys this backend checks answers against.
        '
      }

      allowed_bastions = file {
        technology 'text file'
        title 'allowed_bastions'
        summary '/etc/open-bastion/allowed_bastions'
        description '
          The bastions whose vouchers this backend accepts. `ob-bastion-id`
          prints the id an operator pastes here. Installed before the
          principals helper: without it the helper would accept direct SSO
          certificates.
        '
      }

      nss_openbastion_conf = file {
        technology 'configuration file'
        title 'nss_openbastion.conf'
        summary '/etc/open-bastion/nss_openbastion.conf'
        description '
          Which portal the NSS library asks for an account, whether answers
          must be signed, and the pin of the portal certificate.
        '
      }

      service_accounts_conf = file {
        technology 'configuration file'
        title 'service-accounts.conf'
        summary '/etc/open-bastion/service-accounts.conf'
        description '
          The local accounts allowed to authenticate without a portal round
          trip, each with the fingerprint of its key.
        '
      }

      sshd_dropin = generated-file {
        technology 'sshd configuration'
        title 'sshd drop-in'
        summary '/etc/ssh/sshd_config.d/open-bastion.conf'
        description '
          The backend variant: `AuthorizedPrincipalsCommand` runs
          `ob-ssh-principals.backend`, which accepts a certificate only when
          its voucher carries a bastion id listed in `allowed_bastions`. No
          `ForceCommand` (a backend is not recorded), no agent forwarding.
        '
      }

      nsswitch_conf = generated-file {
        technology 'NSS configuration'
        title 'nsswitch.conf'
        summary '/etc/nsswitch.conf'
        description '
          `passwd: ... openbastion` and the group line: what makes the host
          ask the portal for an account the local files do not have.
        '
      }

      audit_rules = file {
        technology 'audit rules'
        title 'open-bastion.rules'
        summary '/etc/audit/rules.d/open-bastion.rules'
      }

      logrotate_conf = file {
        technology 'logrotate configuration'
        title 'logrotate: open-bastion'
        summary '/etc/logrotate.d/open-bastion'
      }

      hardening_logind = file {
        technology 'systemd-logind configuration'
        title 'logind.conf.d: open-bastion'
        summary '/etc/systemd/logind.conf.d/open-bastion.conf'
      }

      hardening_limits = file {
        technology 'PAM limits'
        title 'limits.d: open-bastion'
        summary '/etc/security/limits.d/open-bastion.conf'
      }

      hardening_at_allow = file {
        technology 'at allowlist'
        title 'at.allow'
        summary '/etc/at.allow'
      }

      hardening_cron_allow = file {
        technology 'cron allowlist'
        title 'cron.allow'
        summary '/etc/cron.allow'
      }

      /* What writes them: the same package scripts as on the bastion. */

      ob_bastion_setup = executable {
        #Bash
        technology 'shell script'
        title 'ob-bastion-setup'
        summary 'Deployment and re-configuration entry point'

        this .produces sshd_dropin
        this .produces nsswitch_conf
        this .produces allowed_bastions
        this .produces openbastion_pam_stack
        this .produces open_bastion_ca_pub
        this .produces audit_rules
        this .produces hardening_logind
        this .produces hardening_limits
        this .produces hardening_at_allow
        this .produces hardening_cron_allow
      }

      ob_enroll = executable {
        #Bash
        technology 'shell script'
        title 'ob-enroll'
        summary 'Enrols this host with the portal (OIDC device grant)'

        this .produces token
      }

      ob_heartbeat = executable {
        #Bash
        technology 'shell script'
        title 'ob-heartbeat'
        summary 'Rotates the token and the JWKS'

        this .produces token 'rotates it'
        this .produces sso_jwks 'rotates it'
      }

      ob_krl_refresh = executable {
        #Bash
        technology 'shell script'
        title 'ob-krl-refresh'
        summary 'Revocation list refresh'

        this .produces revoked_keys
      }
    }

  }
}
