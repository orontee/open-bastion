model {
  workstation = zone {
    technology 'workstation'
    title 'Workstation'

    style {
      color gray
    }

    user = actor {
      title 'User'

      it .requests platform.central-authority.llng.portal 'requests access token, SSH certificates, revokes'
      it .connects platform.bastion
      it .uses user_client 'signs their SSH key before connecting'
    }

    user_client = external-component {
      #HTTP
      technology 'browser / curl'
      title 'User HTTP client'
      summary "The user's own HTTP client"

      style {
        shape browser
      }
    }

    user_keypair = file {
      technology 'OpenSSH key pair'
      title 'SSH key pair'
      summary '~/.ssh/id_ed25519, ~/.ssh/id_ed25519.pub'
      description '
        Generated by the user and kept on the workstation. Only the public half is ever sent: the private half does not leave the machine, and the certificate is signed for it.
      '

      style {
        icon bootstrap:key-fill
      }
    }

    credential_cache = file {
      technology 'AES-256-GCM encrypted cache'
      title 'Offline credential cache'
      summary '/var/cache/open-bastion/credentials'
      description '
        What lets a desktop workstation authenticate a password with the portal down. It ships in the experimental `open-bastion-desktop` package, and a server has none: what a server keeps through an outage is its authorization cache. An entry is written at a successful online login, an Argon2id verifier sealed under a root-only key file, and it is consumed only while the portal is unreachable: five failures lock it, and it is revalidated online at the next unlock.
      '

      metadata {
        ttl '604800 s (offline_cache_ttl, 7 days)'
      }
    }

    user_certificate = file {
      technology 'OpenSSH certificate'
      title 'SSH certificate'
      summary '~/.ssh/id_ed25519-cert.pub'
      description '
        What the portal returns for that public key, and what the bastion accepts. It carries the identity, the validity window and the principals, and every host verifies it against the CA before PAM is consulted.
      '

      style {
        color blue
        icon bootstrap:patch-check
      }
    }

    user_client .uses user_keypair 'reads the public half'
    user_client .produces user_certificate 'writes it as id_ed25519-cert.pub'
    user .uses user_certificate 'presents it to connect'
    user .produces user_keypair 'generates it on the workstation'


    administrator = actor {
      title 'Administrator'
      summary 'Deploys and configures Open Bastion components'
      description '
        The administrator deploys Open Bastion and the LemonLDAP::NG plugins. He enrols backends in LemondLDAP::NG.

        The administrator Writes LLNG rules authorizing SSH and sudo access for end users. He revokes access when needed.

        Depending on the organization size, identities and access management can be delegated to an IAG operator.
      '

      it -> platform.bastion 'Deploy & configure Open Bastion'
      it -> platform.backend 'Deploy & configure Open Bastion'
      it -> platform.central-authority 'Deploy Open Bastion LLNG plugins, enroll backend, manage KRLs, identities and access rules'
    }

    administrator_client = external-component {
      #HTTP
      technology 'browser / curl'
      title 'Administrator HTTP client'
      summary "The administrator's own HTTP client"

      style {
        shape browser
      }
    }

  }

  platform = zone {
    technology 'deployment'
    title 'Platform'
  }
}
