specification {
  element actor {
    style {
      shape person
      color green
    }
  }
  element zone

  element server {
    style {
      icon bootstrap:pc
    }
  }
  element workstation {
    style {
      icon bootstrap:diagram-3
    }
  }

  element external-server {
    style {
      color amber
      icon bootstrap:server
    }
  }

  /* Software outside the platform: not ours to operate, drawn grey. */
  element external-component {
    style {
      color amber
    }
  }

  element systemd-unit {
    technology 'systemd unit'
  }
  element systemd-template-unit {
    technology 'systemd template unit'
  }

  element executable {
    style {
      icon bootstrap:gear
    }
  }
  element library
  element external-library {
    style {
      color amber
    }
  }
  element site
  element plugin {
    style {
      icon bootstrap:puzzle
    }
  }
  
  element component
  element configuration
  element file {
    style {
      shape document
      color muted
    }
  }
  element generated-file {
    style {
      shape document
      color muted
    }
  }

  relationship uses {
    title 'uses'
  }

  relationship runs {
    title 'runs'
  }

  relationship triggers {
    title 'triggers'
  }

  relationship produces {
    title 'produces'
  }

  relationship reads {
    title 'reads'
  }

  relationship requests {
    title 'requests'
    technology 'HTTP'
  }

  relationship connects {
    title 'connects'
    technology 'SSH'
  }

  tag Bash
  tag C
  tag HTTP
  tag LDAP
  tag LemonLDAP-NG
  tag Perl
  tag YAML
  tag generated
  tag socket
  tag template
}
