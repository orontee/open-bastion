model {

  control-node = workstation {
    technology 'workstation'

    ob-builder = executable {
      #Bash
      technology 'shell script'
      title 'ob-builder'

      this .uses installer-sh-in
      this .produces installer-sh
      this .uses main-yml-in
      this .produces main-yml
    }

    installer-sh-in = file {
      #Bash #template
      technology 'Bash template'
      title 'installer.sh.in'
      summary 'Shell installer template'

      style {
        icon bootstrap:files
      }
    }

    installer-sh = generated-file {
      #Bash
      technology 'Bash'
      title 'installer.sh'
      summary 'Shell installer'

      style {
        icon bootstrap:filetype-sh
      }
    }

    main-yml-in = file {
      #YAML #template
      technology 'Ansible template'
      title 'main.yml.in'
      summary 'Ansible task template'

      style {
        icon bootstrap:files
      }
    }

    main-yml = generated-file {
      #YAML
      technology 'Ansible'
      title 'main.yml'
      summary 'Ansible task'

      style {
        icon bootstrap:filetype-yml
      }
    }
  }
}
